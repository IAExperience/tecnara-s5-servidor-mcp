# Copiad este fichero como .env y rellenadlo. El .env NUNCA se sube a GitHub.

# Para que Claude responda con citas (preguntar.py). La da el formador.
ANTHROPIC_API_KEY=

# Embeddings: gemini, voyage o ninguno (ninguno = solo búsqueda por palabras, BM25)
EMBEDDINGS=gemini
# Gemini: gratis en https://aistudio.google.com con la Gmail del equipo
GEMINI_API_KEY=
# Voyage AI (la del curso oficial): https://dash.voyageai.com
VOYAGE_API_KEY=
